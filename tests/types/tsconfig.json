{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "baseUrl": "../..",
    "paths": { "next/*": ["packages/prnext/compat/*.d.cts"] }
  },
  "include": ["*.tsx"]
}
