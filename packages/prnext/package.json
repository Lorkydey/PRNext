{
  "name": "@thomas.f/prnext",
  "version": "0.1.19-alpha",
  "license": "MIT",
  "description": "Experimental Rust-powered runtime for Next.js apps, React and npm",
  "homepage": "https://prnext.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lorkydey/PRNext.git",
    "directory": "packages/prnext"
  },
  "bugs": {
    "url": "https://github.com/Lorkydey/PRNext/issues",
    "email": "contact@heythomas.dev"
  },
  "author": {
    "name": "Thomas",
    "url": "https://github.com/Lorkydey"
  },
  "keywords": [
    "prnext",
    "nextjs",
    "react",
    "rust",
    "framework",
    "ssr",
    "server-components"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "AI.md",
    "docs/ai/",
    "cli.mjs",
    "index.mjs",
    "build/",
    "runtime/",
    "compat/",
    "native/",
    "release/",
    "vendor/"
  ],
  "scripts": {
    "prepublishOnly": "node release/verify.mjs"
  },
  "bin": {
    "prnext": "./cli.mjs",
    "prn": "./cli.mjs"
  },
  "exports": {
    "./AI.md": "./AI.md",
    "./docs/ai/manifest.json": "./docs/ai/manifest.json",
    "./docs/ai/quickstart.md": "./docs/ai/quickstart.md",
    "./docs/ai/routing.md": "./docs/ai/routing.md",
    "./docs/ai/data.md": "./docs/ai/data.md",
    "./docs/ai/compatibility.md": "./docs/ai/compatibility.md",
    "./docs/ai/deployment.md": "./docs/ai/deployment.md",
    "./docs/ai/troubleshooting.md": "./docs/ai/troubleshooting.md",
    "./package.json": "./package.json",
    "./og": {
      "types": "./compat/og.d.cts",
      "default": "./compat/og.cjs"
    },
    "./font/local": {
      "types": "./compat/font-local.d.cts",
      "default": "./compat/font-local.cjs"
    },
    "./font/google": {
      "types": "./compat/font-google.d.cts",
      "default": "./compat/font-google.cjs"
    },
    ".": {
      "types": "./compat/index.d.ts",
      "default": "./index.mjs"
    },
    "./route": {
      "types": "./compat/typed-route.d.cts",
      "default": "./runtime/typed-route.mjs"
    },
    "./link": "./compat/link.cjs",
    "./head": "./compat/head.cjs",
    "./script": {
      "types": "./compat/script.d.cts",
      "default": "./compat/script.cjs"
    },
    "./app": {
      "types": "./compat/app.d.cts",
      "default": "./compat/app.cjs"
    },
    "./document": {
      "types": "./compat/document.d.cts",
      "default": "./compat/document.cjs"
    },
    "./error": {
      "types": "./compat/error.d.cts",
      "default": "./compat/error.cjs"
    },
    "./dynamic": {
      "types": "./compat/dynamic.d.cts",
      "default": "./compat/dynamic.cjs"
    },
    "./image": {
      "types": "./compat/image.d.cts",
      "default": "./compat/image.cjs"
    },
    "./router": "./compat/router.cjs",
    "./compat/router": {
      "types": "./compat/compat/router.d.cts",
      "default": "./compat/compat-router.cjs"
    },
    "./navigation": "./compat/navigation.cjs",
    "./headers": "./compat/headers.cjs",
    "./server": "./compat/server.cjs",
    "./cache": "./compat/cache.cjs",
    "./cache/redis": {
      "types": "./compat/redis-cache.d.cts",
      "default": "./compat/redis-cache.cjs"
    },
    "./offline": {
      "types": "./compat/offline.d.cts",
      "default": "./compat/offline.cjs"
    },
    "./constants": "./compat/constants.cjs"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/generator": "^7.29.0",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@edge-runtime/vm": "5.0.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@mapbox/node-pre-gyp": "2.0.3",
    "@rollup/pluginutils": "5.4.0",
    "acorn": "8.18.0",
    "acorn-import-attributes": "1.9.5",
    "async-sema": "3.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "bindings": "1.5.0",
    "browserslist": "4.29.0",
    "dotenv": "16.6.1",
    "dotenv-expand": "11.0.7",
    "esbuild": "^0.28.2",
    "estree-walker": "2.0.2",
    "fontkit": "2.0.4",
    "get-tsconfig": "4.14.3",
    "glob": "14.0.2",
    "graceful-fs": "4.2.11",
    "html-to-image": "1.11.13",
    "jsonc-parser": "3.3.1",
    "lightningcss": "1.31.0",
    "loader-runner": "4.3.2",
    "minimatch": "11.0.1",
    "node-gyp-build": "4.8.4",
    "oxc-parser": "0.155.0",
    "path-to-regexp": "6.3.0",
    "picomatch": "4.0.7",
    "postcss": "8.5.28",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-preset-env": "11.5.3",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "react-refresh": "0.19.0",
    "resolve-from": "5.0.0",
    "schema-utils": "4.3.3",
    "webpack": "5.111.1"
  },
  "peerDependencies": {
    "@redis/client": "^6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1"
  },
  "peerDependenciesMeta": {
    "@redis/client": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "prnext-darwin-arm64": "0.1.19-alpha",
    "prnext-darwin-x64": "0.1.19-alpha",
    "prnext-linux-arm64-gnu": "0.1.19-alpha",
    "prnext-linux-x64-gnu": "0.1.19-alpha",
    "@thomas.f/prnext-win32-x64-msvc": "0.1.19-alpha",
    "@thomas.f/prnext-win32-arm64-msvc": "0.1.19-alpha"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
