{
  "name": "prnext-monorepo",
  "private": true,
  "version": "0.2.0-alpha",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/prnext",
    "examples/basic",
    "examples/app"
  ],
  "scripts": {
    "build": "node packages/prnext/cli.mjs build",
    "dev": "node packages/prnext/cli.mjs dev",
    "start": "node packages/prnext/cli.mjs start",
    "build:native": "node scripts/cargo.mjs build --release",
    "test:unit": "node --test --test-concurrency=2 packages/prnext/build/*.test.mjs packages/prnext/runtime/*.test.mjs packages/prnext/native/*.test.mjs scripts/npm-metadata.test.mjs scripts/vendor-nft.test.mjs scripts/prepare-fontkit.test.mjs scripts/main-module.test.mjs scripts/security-audit.test.mjs scripts/release-*.test.mjs tests/performance/*.test.mjs tests/reference/*.test.mjs scripts/package-prepared.test.mjs scripts/portable-redis.test.mjs",
    "test:ci": "node --test scripts/ci-*.test.mjs scripts/pre-push.test.mjs scripts/install-hooks.test.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "release:check": "node packages/prnext/release/verify.mjs --local",
    "release:prepare-og": "node scripts/prepare-og.mjs",
    "release:pack-native": "node scripts/package-native.mjs",
    "release:verify-artifacts": "node scripts/verify-npm-artifacts.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:cli": "node --test scripts/cli-global.test.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json && tsc -p examples/basic/tsconfig.json && tsc -p examples/app/tsconfig.json",
    "test:rust": "node scripts/cargo.mjs test --workspace",
    "test:e2e": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:compat": "playwright test --config playwright.compat.config.mjs",
    "test:reference": "node tests/reference/run.mjs",
    "test:next-compat": "node --test --test-concurrency=1 tests/next-conformance.mjs tests/next-app-conformance.mjs tests/next-primitives-conformance.mjs tests/next-ecosystem-conformance.mjs",
    "test": "npm run test:unit && npm run test:types && npm run test:rust && npm run test:e2e",
    "release:prepare-fontkit": "node scripts/prepare-fontkit.mjs",
    "ci:quick": "node scripts/ci-local.mjs --mode quick",
    "ci:local": "node scripts/ci-local.mjs --mode full",
    "test:unit:fast": "node scripts/ci-unit-fast.mjs"
  },
  "devDependencies": {
    "@builder.io/partytown": "0.10.3",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@opentelemetry/api": "1.10.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/query-core": "5.107.1",
    "@tanstack/react-query": "5.107.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/og": "1.0.3",
    "autoprefixer": "10.6.2",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "oxc-transform-react": "0.158.0",
    "relay-runtime": "21.0.1",
    "sass": "1.108.1",
    "styled-components": "6.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
