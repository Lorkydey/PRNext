{
  "name": "prnext-monorepo",
  "private": true,
  "version": "0.1.18-alpha",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/prnext",
    "examples/basic",
    "examples/app"
  ],
  "scripts": {
    "build": "node packages/prnext/cli.mjs build",
    "dev": "node packages/prnext/cli.mjs dev",
    "start": "node packages/prnext/cli.mjs start",
    "build:native": "node scripts/cargo.mjs build --release",
    "test:unit": "node --test --test-concurrency=2 packages/prnext/build/*.test.mjs packages/prnext/runtime/*.test.mjs packages/prnext/native/*.test.mjs scripts/npm-metadata.test.mjs tests/performance/*.test.mjs tests/reference/*.test.mjs",
    "test:ci": "node --test scripts/ci-*.test.mjs scripts/pre-push.test.mjs scripts/install-hooks.test.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "release:check": "node packages/prnext/release/verify.mjs --local",
    "release:prepare-og": "node scripts/prepare-og.mjs",
    "release:pack-native": "node scripts/package-native.mjs",
    "release:verify-artifacts": "node scripts/verify-npm-artifacts.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json && tsc -p examples/basic/tsconfig.json && tsc -p examples/app/tsconfig.json",
    "test:rust": "node scripts/cargo.mjs test --workspace",
    "test:e2e": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:compat": "playwright test --config playwright.compat.config.mjs",
    "test:reference": "node tests/reference/run.mjs",
    "test:next-compat": "node --test --test-concurrency=1 tests/next-conformance.mjs tests/next-app-conformance.mjs tests/next-primitives-conformance.mjs tests/next-ecosystem-conformance.mjs",
    "test": "npm run test:unit && npm run test:types && npm run test:rust && npm run test:e2e"
  },
  "devDependencies": {
    "@builder.io/partytown": "0.10.3",
    "@opentelemetry/api": "1.10.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/og": "1.0.3",
    "autoprefixer": "10.6.1",
    "fflate": "0.7.5",
    "sass": "1.105.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
